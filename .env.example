# Copy to .env. Never commit .env. All data in this project is synthetic.

# Champion: the frontier model. Any OpenAI-compatible endpoint, or CHAMPION_BASE_URL=bedrock for Amazon Bedrock (IAM auth).
CHAMPION_BASE_URL=https://api.deepseek.com/v1
CHAMPION_MODEL=deepseek-chat
CHAMPION_API_KEY=

# Challenger: the vLLM server from `modal deploy modal_app.py` (adapters are addressed as claimdesk-v1, claimdesk-v2, ...)
CHALLENGER_BASE_URL=https://<workspace>--claimdesk-serve.us-east.modal.run/v1
CHALLENGER_API_KEY=

# OCR (Tesseract with the Hungarian language pack)
TESSERACT_CMD=tesseract
TESSDATA_DIR=

# Leave empty locally (data/store). On AWS, Terraform sets STORE_BUCKET, QUEUE_URL and ORIGIN_SECRET.
STORE_BUCKET=
